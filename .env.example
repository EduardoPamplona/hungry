# Copy to .env and adjust. compose reads it automatically.

# --- Postgres ---
POSTGRES_USER=hungry
POSTGRES_PASSWORD=hungry
POSTGRES_DB=hungry

# --- LLM backend switch ---
# llama  -> local llama.cpp server (default, free, CPU)
# hosted -> an OpenAI-compatible hosted API (fill the HOSTED_* vars below)
LLM_BACKEND=llama

# Default (llama) backend. These point at the in-compose llama.cpp server.
LLM_BASE_URL=http://llama:8000/v1
LLM_MODEL=qwen2.5-3b-instruct
LLM_API_KEY=sk-noauth
LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Hosted fallback (only used when LLM_BACKEND=hosted).
# OpenAI:    HOSTED_BASE_URL=https://api.openai.com/v1        HOSTED_MODEL=gpt-4o-mini
# Anthropic: HOSTED_BASE_URL=https://api.anthropic.com/v1     HOSTED_MODEL=claude-haiku-4-5-20251001
HOSTED_BASE_URL=
HOSTED_MODEL=
HOSTED_API_KEY=
